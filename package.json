{
  "name": "dungerra-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Dungerra desktop app (Tauri shell) for solo and LAN play",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:deps": "npm run build:sidecar && npm run build:web",
    "dev": "npm run build:deps && tauri dev",
    "build": "npm run build:deps && tauri build",
    "icons": "tauri icon ../dungerra/src/favicon.png"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6"
  }
}
